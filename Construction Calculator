    "## PROJECT SIZE CATEGORY\n",
    "def classify_project_size(wall_area):\n",
    "    \"\"\"The function classify the construction project based on wall area \"\"\"\n",
    "    if wall_area > 100: \n",
    "        # this checks if the wall area is greater than 100 meter square and returns size\n",
    "        size = \"Large\"\n",
    "    elif 50 <= wall_area <= 100:\n",
    "        # this checks if the wall area is between 50 to 100 meter square\n",
    "        size = \"Medium\"\n",
    "    else:\n",
    "        # this checks if the wall area is less than 50 meter square and returns size\n",
    "        size = \"Small\"\n",
    "    return size\n",
    "\n",
    "## MATERIAL BUDGET CATEGORY\n",
    "def classify_budget(total_material_cost):\n",
    "    \"\"\" The function receives and classify the estimated material cost \"\"\"\n",
    "    \n",
    "    if total_material_cost > 3000000:\n",
    "        # This checks if total_material_cost is greater than 3 million and returns the category\n",
    "        return \"High Budget\"\n",
    "    elif 1000000 <= total_material_cost <= 3000000:\n",
    "        # This checks if total_material_cost isbetween 1 million to 3 million and returns the category\n",
    "        return \"Medium Budget\"\n",
    "    else:\n",
    "         # This checks if total_material_cost is less than 1 million and returns the category\n",
    "        return \"Low Budget\"\n",
    "\n",
    "## PROJECT PRIORITY\n",
    "def determine_project_priority(wall_area, total_material_cost):\n",
    "    \"\"\" The function receives wall_area and total_material_cost and compares based on the logical operations \"\"\"\n",
    "    \n",
    "    if wall_area > 100 and total_material_cost > 3000000:\n",
    "        return \"Urgent\"\n",
    "    elif wall_area > 100 or total_material_cost > 3000000: \n",
    "        return \"High\"\n",
    "    elif wall_area >= 50 and wall_area <= 100:\n",
    "        return \"Normal\"\n",
    "    else:\n",
    "        return \"Low\"\n",
    "\n",
    "## RECOMMEND ACTION\n",
    "def recommend_action(wall_area, total_material_cost):\n",
