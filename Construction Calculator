    "## OBJECTIVE: Calculate the Material Cost Estimate for construction Project\n",
    "\n",
    "# Recieve input for various construction parameters\n",
    "projects = [] #This stores the user input as a dictionary in a List\n",
    "\n",
    "\n",
    "\n",
    "## These are constant for all projects, hence placed outside the loop to avoid repition\n",
    "waste_allowance_rate = int(input(\"Enter Waste Allowance Rate:\")) # user inputs the allowance rate 5\n",
    "\n",
    "block_price = int(input(\"Enter the block price:\")) # user inputs block price and the while loop is set in motion\n",
    "while block_price <= 0:\n",
    "        # the while condition ensures that block price is not negative nor Zero\n",
    "        print(\"Block price must be greater than Zero\")\n",
    "        block_price = int(input(\"Enter the block price:\"))\n",
    "        # the second input statement gives the user another chance to enter the correct value\n",
    "        print()\n",
    "\n",
    "cement_price = int(input(\"Enter the cement price\")) # user inputs cement price and the while loop is set in motion\n",
    "while cement_price <= 0:\n",
    "        # the while condition ensures that cement price is not negative nor Zero\n",
    "        print(\"Cement Price must be greater than Zero\")\n",
    "        cement_price = int(input(\"Enter the cement price\"))\n",
    "        # the second input statement gives the user another chance to enter the correct value\n",
    "        print()\n",
    "sand_price = int(input(\"Enter sand price:\")) # user inputs sand price and the while loop is set in motion\n",
    "while sand_price <= 0:\n",
    "        # the while condition ensures that sand price is not negative nor Zero\n",
    "        print(\"Sand Price must be greater than Zero\")\n",
    "        sand_price = int(input(\"Enter sand price:\"))\n",
    "        # the second input statement gives the user another chance to enter the correct value\n",
    "        print()\n",
    "print()\n",
    "\n",
    "\n",
    "project_id = 1 # Intialization of the product_id \n",
    "while True:\n",
    "    project_name = input(\"Enter project name or exit to leave:\") # user inputs project name\n",
    "    if project_name == \"exit\": # if user wants to terminate the operation, he inputs exit, breaking the loop\n",
    "        break\n",
    "    \n",
    "    wall_length = int(input(\"Enter wall length:\")) \n",
    "    # user inputs wall length and the while loop ensures they input values greater than zero\n",
    "    while wall_length <= 0:\n",
    "        print(\"Wall Length must be greater than Zero\")\n",
    "        wall_length = int(input(\"Enter wall length:\"))\n",
    "        print()\n",
    "        \n",
    "    wall_height = float(input(\"Enter wall height:\")) \n",
    "    # user inputs wall length and the while loop ensures they input values greater than zero\n",
    "    while wall_height <= 0:\n",
    "        print(\"Wall Height must be greater than Zero\")\n",
    "        wall_height = int(input(\"Enter wall Height:\"))\n",
    "        print()\n",
    "\n",
    "    ## The validation code   \n",
    "   \n",
    "    ## Validate project Name\n",
    "    project_name = project_name.strip().title() # This cleans the input of the user in project name\n",
    "    if project_name == \"\": \n",
    "        # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_name_provided = False\n",
    "    else:\n",
    "        is_name_provided = True\n",
    "    \n",
    "    ## Validate Wall Length\n",
    "    if wall_length <= 0:\n",
    "         # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_length_provided =  False\n",
    "    else:\n",
    "        is_name_provided = True\n",
    "    \n",
    "    ## Validate Wall height\n",
    "    if wall_height <= 0:\n",
    "         # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_height_provided = False\n",
    "    else: \n",
    "        is_height_provided = True\n",
    "    \n",
    "       \n",
    "    ## Validate Material prices\n",
    "    if block_price <= 0:\n",
    "         # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_blockprice_provided =  False\n",
    "    else:\n",
    "        is_blockprice_provided =  True\n",
    "\n",
    "    if cement_price <= 0:\n",
    "         # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_cementprice_provided = False \n",
    "    else:\n",
    "        is_cementprice_provided = True\n",
    "        \n",
    "    if sand_price <= 0:\n",
    "         # if input is empty, it saves the input as False, else true ensuring data validation\n",
    "        is_sandprice_provided = False\n",
    "    else:\n",
    "        is_sandprice_provided = True\n",
    "        \n",
    "\n",
    "    project_information = {\n",
    "        # This stores user input together in form of key value pairs as a dictionary\n",
    "        \"Project ID\" : project_id,\n",
    "        \"Project Name\": project_name,\n",
    "        \"Wall Length\": wall_length,\n",
    "        \"Wall Height\": wall_height,\n",
    "        \"Block Price\": block_price,\n",
    "        \"Cement Price\": cement_price,\n",
    "        \"Sand Price\" : sand_price    \n",
    "    }\n",
    "    projects.append(project_information) # This stores all the dictionaries created above and stores it in a list\n",
    "    \n",
    "       \n",
    "    project_id += 1 # This ensures that the while loop is updated\n",
    "    \n",
    "    print(\"Do you want to calculate another construction project?\")\n",
    "    user_input = input(\"Input Yes to continue calculation or No to Stop:\")\n",
    "    # This allows user the option to perform another construction calculation or exit the program\n",
    "    \n",
    "    if user_input.strip().lower() == \"no\":\n",
    "        # This breaks the while loop if the user enters no\n",
    "        break\n",
    "    print()\n",
    "\n",
    "\n",
    "\n",
    "    \n",
    "## CONSTRUCTION VALIDATION\n",
    "def validate_project(is_id_provided, is_name_provided, is_length_valid, is_height_valid, is_blockprice_valid,is_cementprice_valid, is_sandprice_valid):\n",
    "    \n",
    "    \"\"\"This function receives relevant validation results to determine if it is valid or not\"\"\"\n",
    "    \n",
    "    if is_id_provided and is_name_provided and is_length_valid and is_height_valid and is_blockprice_valid and is_cementprice_valid and is_sandprice_valid:\n",
    "         return \"Valid\"\n",
    "    else:\n",
    "        return \"Invalid\"\n",
    "        \n",
    "\n",
    "## Create various Functions to perform aggregations\n",
    "def calculate_wall_area(wall_length, wall_height) -> float:\n",
    "    \"\"\" The function calculate the area of the wall after the user provides the wall-length and wall height\n",
    "    ARGS:\n",
    "        wall_length (int): The Length of the wall in mm\n",
    "        wall_height (int): The Height of the wall in mm\n",
    "    RETURNS:\n",
    "        wall_area (int): The Area of the wall after the length and height have been multiplied\n",
    "    \"\"\"\n",
    "    wall_area = wall_length * wall_height\n",
    "    return wall_area\n",
    "    \n",
    "wall_area = calculate_wall_area(wall_length, wall_height)  \n",
    " # The return function for the calculate_wall_area is stored in a global variable\n",
    "\n",
    "waste_allowance = waste_allowance_rate/100 \n",
    " # This calculates the waste_allowance as a global variable\n",
    "print()\n",
    "\n",
    "\n",
    "def calculate_blocks_required(wall_area, waste_allowance)-> float:\n",
    "    \"\"\"The function calculates the total number of blocks required after the area, waste_allowance and the waste_block has been aggregated\n",
    "    \n",
    "        Note: 10 blocks are used per square meters\n",
    "    ARGS:\n",
    "        wall_area (int): The Area of the wall after the length and height have been multiplied\n",
    "        waste_allowance (int): Material allowance to account for wastage \n",
    "    RETURNS:\n",
    "        blocks_required (int): The number of blocks required after the wall area and the number of blocks per square meter has been multiplied\n",
    "        waste_block (int): The number of blocks required multiplied by the waste allowance\n",
    "        total_block (int): The addition of blocks_required and waste_block\n",
    "    \"\"\"\n",
    "      \n",
    "    blocks_required = (wall_area * 10)\n",
    "    waste_block = blocks_required * waste_allowance\n",
    "    total_block = round(blocks_required + waste_block)\n",
    "    \n",
    "    return blocks_required, waste_block, total_block\n",
    "    \n",
    "blocks_required, waste_block, total_block = calculate_blocks_required(wall_area, waste_allowance)\n",
    "\n",
    "\n",
    "    \n",
    "\n",
    "\n",
    "def calculate_cements_bags_required(wall_area, waste_allowance):\n",
    "    \"\"\" The function calculates the total bag of cements required after the cement bags and the waste bag have been aggregated\n",
    "\n",
    "        Note: A bag is equivalent to 5 square meters\n",
    "    ARGS:\n",
    "        wall_area (int): The Area of the wall after the length and height have been multiplied\n",
    "    RETURNS:\n",
    "        cement_bag: This is the wall_area divided by 5\n",
    "        cement_waste: This is the cement_bag multiplied by the waste_allowance\n",
    "        total_cement_bag: This is the sum of the cement_bag and cement_waste\n",
    "    \"\"\"\n",
    "   \n",
    "    cement_bag = wall_area / 5\n",
    "    cement_waste = cement_bag * waste_allowance\n",
    "    total_cement_bags = round(cement_bag + cement_waste)\n",
    "   \n",
    "    return cement_bag, cement_waste, total_cement_bags\n",
    "    \n",
    "cement_bag, cement_waste, total_cement_bags = calculate_cements_bags_required(wall_area, waste_allowance)\n",
    "\n",
    "\n",
    "def calculate_sand_requirement(wall_area, waste_allowance):\n",
    "    \"\"\" The function calculates the total sand required after the sand trips and sand waste have been aggregated\n",
    "\n",
    "        Note: 1 trip of sand covers 20 m²\n",
    "    ARGS:\n",
    "        wall_area (int): The Area of the wall after the length and height have been multiplied\n",
    "    RETURNS:\n",
    "        sand_trip: This is the wall_area divided by 20\n",
    "        sand_waste: This is the sand_waste multiplied by the waste_allowance\n",
    "        total_sand_trips: This is the sum of the cement_bag and cement_waste\n",
    "    \"\"\"\n",
    "   \n",
    "    sand_trip = wall_area / 20\n",
    "    sand_waste = sand_trip * waste_allowance\n",
    "    total_sand_trips = round(sand_trip + sand_waste)\n",
    "    \n",
    "    return sand_trip, sand_waste, total_sand_trips\n",
    "    \n",
    "sand_trip, sand_waste, total_sand_trips = calculate_sand_requirement(wall_area, waste_allowance)\n",
    "\n",
    "    \n",
    "def calculate_material_cost()-> float:\n",
    "    \"\"\" This function calculates the total estimated cost after the block, sand, and cement costs have been calculated \n",
    "      ARGS:\n",
    "          total_block(float): calculates the total number of blocks required after the area, waste_allowance and the waste_block has been aggregated\n",
    "          total_cement_bags(float):calculates the total bag of cements required after the cement bags and the waste bag have been aggregated\n",
    "          total_sand_trips(floats): calculates the total sand required after the sand trips and sand waste have been aggregated\n",
    "     RETURNS:\n",
    "         block_cost: total block multiplied by block price\n",
    "         cement_cost: total cement bag multiplied by cement price\n",
    "         sand_cost: total sand trips multiplied by sand price\n",
    "         total_material_cost: this aggregate the block cost, cement cost and the sand cost\n",
    "    \n",
    "    \"\"\"\n",
    "\n",
    "    total_block = calculate_blocks_required(wall_area, waste_allowance)[2]\n",
    "     # This returns the third output of the calculate_blocks_required function, hence the [2]\n",
    "    \n",
    "    total_cement_bags = calculate_cements_bags_required(wall_area, waste_allowance)[2]\n",
    "    # This returns the third output of the calculate_cements_bags_required function, hence the [2]\n",
    "    \n",
    "    total_sand_trips = calculate_sand_requirement(wall_area, waste_allowance)[2]\n",
    "    # This returns the third output of the calculate_sand_requirement, hence the [2]\n",
    "       \n",
    "    ## Material Cost Calculation\n",
    "    # Calculate Block Cost\n",
    "    block_cost = total_block * block_price\n",
    "    \n",
    "    # Calculate Cement Cost\n",
    "    cement_cost = total_cement_bags * cement_price\n",
    "    \n",
    "    # Calculate Sand Cost\n",
    "    sand_cost = total_sand_trips * sand_price\n",
    "    \n",
    "    # Total Estimated Cost\n",
    "    total_material_cost = block_cost + cement_cost + sand_cost\n",
    "   \n",
    "    \n",
    "    return block_cost, cement_cost, sand_cost, total_material_cost\n",
    "\n",
    "\n",
    "\n",
    "\n",
